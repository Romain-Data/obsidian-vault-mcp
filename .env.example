# Copier sans écraser : cp -n .env.example .env && chmod 600 .env
# Ce fichier est un modèle : aucune valeur réelle ici. Le vrai .env n'est jamais commité.

# --- Exposition -------------------------------------------------------------
# URL publique HTTPS du serveur (= issuer OAuth ; l'audience des jetons est PUBLIC_URL/mcp)
PUBLIC_URL=https://mcp.example.com

# --- Coffre -----------------------------------------------------------------
# Dossier du coffre sur l'hôte, monté en lecture seule (ex. données Nextcloud : .../ncdata/<utilisateur>/files/<dossier>)
COFFRE_HOTE=/chemin/vers/ncdata/utilisateur/files/Obsidian
# Description reprise dans chaque outil : aide Claude à savoir quand ouvrir le coffre (reste dans ton .env)
COFFRE_DESCRIPTION="coffre Obsidian personnel de l'utilisateur (notes Markdown : projets, journal, références)"
COFFRE_TITRE="Coffre Obsidian"

# --- Écritures WebDAV (compte Nextcloud dédié, partage SANS droit de suppression) ---
NEXTCLOUD_URL=http://nextcloud-aio-apache:11000
NEXTCLOUD_HOST=cloud.example.com
NEXTCLOUD_USER=claude-mcp
NEXTCLOUD_DOSSIER=Shared/Obsidian
NEXTCLOUD_RESEAU=nextcloud-aio
# [toi] mot de passe d'application du compte NEXTCLOUD_USER
NEXTCLOUD_APP_PASSWORD=''

# --- OAuth : rempli par init_secrets (ne pas saisir à la main) --------------
#   docker compose run --rm -it -v ./.env:/app/.env coffre-mcp python -m coffre_mcp.init_secrets /app/.env
OAUTH_CLIENT_ID=''
OAUTH_CLIENT_SECRET=''
LOGIN_PASSPHRASE_HASH=''
TOTP_SECRET=''
# OAUTH_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback
